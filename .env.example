# 火山引擎豆包语音识别配置
# 复制此文件为 .env 并填入你的配置

# APP ID (从应用管理获取)
VOLCENGINE_APP_ID=4120356295

# Access Token (从流式语音识别大模型页面获取，点击眼睛图标查看)
VOLCENGINE_ACCESS_TOKEN=your_access_token_here

# Resource ID (volc.bigasr.sauc.duration = 大模型1.0 流式识别)
VOLCENGINE_RESOURCE_ID=volc.bigasr.sauc.duration

# 豆包大模型整理配置（用于整合转写模式）
# 从火山方舟获取 API Key
DOUBAO_API_KEY=your_doubao_api_key_here

# 豆包模型 ID 或推理接入点 ID
DOUBAO_MODEL=your_doubao_model_or_endpoint_id_here
